# ============================================================
# SmartSync — переменные окружения для облачного деплоя (Cloud)
# Скопируйте в .env.cloud.prod и заполните своими значениями
# ============================================================

# --- JWT Secret (обязательно сменить!) ---
JWT_SECRET=smartsync_diploma_secret_key_2026

# --- PostgreSQL (Supabase Free / Neon) ---
# 1. Зарегистрироваться на https://supabase.com
# 2. Создать проект → Database → Connection string
# Пример: postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=postgres://user:password@localhost:5432/smartsync?sslmode=disable

# --- MongoDB (MongoDB Atlas Free) ---
# 1. Зарегистрироваться на https://mongodb.com
# 2. Создать кластер Free (M0) → Connect → Drivers → скопировать URI
# Пример: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/
MONGO_URI=mongodb://localhost:27017

# --- Redis (Upstash Free / Redis Cloud Free) ---
# 1. Зарегистрироваться на https://upstash.com
# 2. Создать базу Redis (Free tier: 10 MB) → REST API → Endpoint
# Пример: redis://default:password@xxxxx.upstash.io:6379
REDIS_ADDR=localhost:6379

# --- Grafana (админ-пароль) ---
GF_SECURITY_ADMIN_PASSWORD=admin

# --- Архитектура сервера (arm64 для Ampere/Oracle, amd64 для обычных серверов) ---
# Определяется автоматически при запуске start-cloud.sh
# TARGETARCH=amd64